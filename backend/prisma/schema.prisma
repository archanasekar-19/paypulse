datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id            String   @id @default(uuid())
  employeeCode  String   @unique
  firstName     String
  lastName      String
  email         String   @unique
  department    String
  country       String
  jobTitle      String
  baseSalary    Float
  currency      String
  baseSalaryUSD Float    // Pre-computed normalized USD for fast sorting and aggregations

  // Welfare & Allowances (Additions to Base Pay from Spreadsheet Model)
  bonus         Float    @default(0)
  subsidy       Float    @default(0)
  allowance     Float    @default(0)
  overtimePay   Float    @default(0)
  grossSalary   Float    @default(0) // baseSalary + bonus + subsidy + allowance + overtimePay

  // Attendance & Leave Tracking (For calculating unpaid leave deductions)
  earnedLeaves   Float    @default(18) // Annual earned / paid leaves quota
  leaveDays      Float    @default(0)  // Total leaves taken

  // Deductions of Wages (Subtractions)
  insurance      Float    @default(0)
  leaveDeduction Float    @default(0)

  // Custom Dynamic Additions & Deductions (JSON arrays)
  customAdditions   String?  @default("[]")
  customDeductions  String?  @default("[]")

  // Net Take-Home Salary
  netSalary     Float    @default(0) // grossSalary - (insurance + leaveDeduction)
  netSalaryUSD  Float    @default(0) // Pre-computed normalized USD net salary

  hireDate      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Salary Revision Audit Trail (Immutable history records)
  salaryHistory SalaryHistory[]

  // B-Tree indexes for sub-15ms search, filtering, and sorting over 10,000 records
  @@index([department])
  @@index([country])
  @@index([baseSalaryUSD])
  @@index([netSalaryUSD])
  @@index([department, country])
  @@index([lastName, firstName])
  @@map("employees")
}

model SalaryHistory {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  oldAmount      Float     // Previous base salary (0 for initial onboarding)
  newAmount      Float     // New base salary
  currency       String
  oldAmountUSD   Float?    @default(0)
  newAmountUSD   Float?    @default(0)

  changePercent  Float?    @default(0) // Precomputed % change (e.g. +12.5%)
  reason         String    // 'Initial Offer', 'Annual Review', 'Promotion', 'Market Correction', 'Performance Adjustment'
  changedBy      String    @default("Elena Vance (HR Manager)")
  effectiveDate  DateTime  @default(now())
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([employeeId, effectiveDate])
  @@index([effectiveDate])
  @@map("salary_histories")
}
